{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SihyeonJeon/site2voice/schemas/voice.schema.json",
  "title": "site2voice voice profile",
  "type": "object",
  "required": [
    "schema_version",
    "generator",
    "source",
    "metrics",
    "tone",
    "style",
    "headings",
    "ctas",
    "links",
    "lexicon",
    "paragraph_samples"
  ],
  "properties": {
    "schema_version": {
      "const": "site2voice.voice.v1"
    },
    "generator": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "meta_description": {
      "type": "string"
    },
    "metrics": {
      "type": "object",
      "required": ["words", "sentences", "avg_sentence_words", "headings", "ctas", "links"],
      "properties": {
        "words": {"type": "integer", "minimum": 0},
        "sentences": {"type": "integer", "minimum": 0},
        "avg_sentence_words": {"type": "number", "minimum": 0},
        "avg_heading_words": {"type": "number", "minimum": 0},
        "avg_paragraph_words": {"type": "number", "minimum": 0},
        "avg_cta_words": {"type": "number", "minimum": 0},
        "headings": {"type": "integer", "minimum": 0},
        "ctas": {"type": "integer", "minimum": 0},
        "links": {"type": "integer", "minimum": 0},
        "type_token_ratio": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "tone": {
      "type": "array",
      "items": {"type": "string"}
    },
    "style": {
      "type": "object",
      "required": ["cta_verbs", "punctuation"],
      "properties": {
        "cta_verbs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "punctuation": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      },
      "additionalProperties": true
    },
    "headings": {
      "type": "array",
      "items": {"type": "string"}
    },
    "ctas": {
      "type": "array",
      "items": {"type": "string"}
    },
    "links": {
      "type": "array",
      "items": {"type": "string"}
    },
    "buttons": {
      "type": "array",
      "items": {"type": "string"}
    },
    "lexicon": {
      "type": "array",
      "items": {"type": "string"}
    },
    "paragraph_samples": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
