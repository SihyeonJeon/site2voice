{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SihyeonJeon/site2voice/schemas/voice.schema.json",
  "title": "site2voice voice profile",
  "type": "object",
  "required": [
    "schema_version",
    "generator",
    "source",
    "metrics",
    "tone",
    "style",
    "headings",
    "ctas",
    "links",
    "lexicon",
    "paragraph_samples"
  ],
  "properties": {
    "schema_version": {
      "const": "site2voice.voice.v1"
    },
    "generator": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "meta_description": {
      "type": "string"
    },
    "metrics": {
      "type": "object",
      "required": ["words", "sentences", "avg_sentence_words", "headings", "ctas", "links"],
      "properties": {
        "words": {"type": "integer", "minimum": 0},
        "sentences": {"type": "integer", "minimum": 0},
        "avg_sentence_words": {"type": "number", "minimum": 0},
        "avg_heading_words": {"type": "number", "minimum": 0},
        "avg_paragraph_words": {"type": "number", "minimum": 0},
        "avg_cta_words": {"type": "number", "minimum": 0},
        "avg_link_words": {"type": "number", "minimum": 0},
        "headings": {"type": "integer", "minimum": 0},
        "ctas": {"type": "integer", "minimum": 0},
        "links": {"type": "integer", "minimum": 0},
        "type_token_ratio": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "tone": {
      "type": "array",
      "items": {"type": "string"}
    },
    "style": {
      "type": "object",
      "required": ["cta_verbs", "punctuation"],
      "properties": {
        "cta_verbs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "punctuation": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      },
      "additionalProperties": true
    },
    "output_contract": {
      "type": "object",
      "required": [
        "sentence_words",
        "heading_words",
        "paragraph_words",
        "cta_words",
        "recommended_terms",
        "cta_verbs",
        "minimum_recommended_terms",
        "benchmark_gates"
      ],
      "properties": {
        "sentence_words": {"$ref": "#/$defs/metric_window"},
        "heading_words": {"$ref": "#/$defs/metric_window"},
        "paragraph_words": {"$ref": "#/$defs/metric_window"},
        "cta_words": {"$ref": "#/$defs/metric_window"},
        "recommended_terms": {
          "type": "array",
          "items": {"type": "string"}
        },
        "source_terms": {
          "type": "array",
          "items": {"type": "string"}
        },
        "cta_verbs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "minimum_recommended_terms": {
          "type": "integer",
          "minimum": 0
        },
        "content_rule": {
          "type": "string"
        },
        "domain_firewall": {
          "type": "object",
          "required": ["reference_supplies", "design_md_supplies", "project_must_supply", "rule"],
          "properties": {
            "reference_supplies": {
              "type": "array",
              "items": {"type": "string"}
            },
            "design_md_supplies": {
              "type": "array",
              "items": {"type": "string"}
            },
            "project_must_supply": {
              "type": "array",
              "items": {"type": "string"}
            },
            "rule": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "benchmark_gates": {
          "type": "object",
          "required": ["overall", "copy_safety", "claim_safety"],
          "properties": {
            "overall": {"type": "number", "minimum": 0},
            "copy_safety": {"type": "number", "minimum": 0},
            "claim_safety": {"type": "number", "minimum": 0}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "headings": {
      "type": "array",
      "items": {"type": "string"}
    },
    "ctas": {
      "type": "array",
      "items": {"type": "string"}
    },
    "links": {
      "type": "array",
      "items": {"type": "string"}
    },
    "buttons": {
      "type": "array",
      "items": {"type": "string"}
    },
    "lexicon": {
      "type": "array",
      "items": {"type": "string"}
    },
    "paragraph_samples": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "metric_window": {
      "type": "object",
      "required": ["target", "min", "max"],
      "properties": {
        "target": {"type": "number", "minimum": 0},
        "min": {"type": "number", "minimum": 0},
        "max": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
